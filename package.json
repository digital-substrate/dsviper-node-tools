{
  "name": "@digitalsubstrate/dsviper-tools",
  "version": "0.1.0",
  "description": "Node CLI + REPL tooling over @digitalsubstrate/dsviper — a port of the headless Python dsviper-tools (offline Database/CommitDatabase tools + the universal service REPL client). GUI (cdbe/dbe) and the blocking server stay Python-only.",
  "type": "module",
  "bin": {
    "dsviper-database-export": "bin/database_export.mjs",
    "dsviper-database-import": "bin/database_import.mjs",
    "dsviper-dsm-util": "bin/dsm_util.mjs",
    "dsviper-commit-admin": "bin/commit_admin.mjs",
    "dsviper-service-client": "bin/service_client.mjs"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test",
    "prepublishOnly": "npm test"
  },
  "peerDependencies": {
    "@digitalsubstrate/dsviper": ">=1.2.8 <2"
  },
  "keywords": [
    "dsviper",
    "viper",
    "cli",
    "repl",
    "tools",
    "database",
    "commit"
  ],
  "homepage": "https://github.com/digital-substrate/dsviper-node-tools#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/digital-substrate/dsviper-node-tools.git"
  },
  "bugs": {
    "url": "https://github.com/digital-substrate/dsviper-node-tools/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
